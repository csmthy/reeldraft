# Copy to .env. Everything is optional; the pipeline skips sources it has no key for.
# Contact address sent in the User-Agent when fetching public pages (be a polite scraper)
CONTACT_EMAIL=
# TMDB (free, non-commercial w/ attribution): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb ($1+/mo patron tier recommended for the bulk pull): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Pool threshold (IMDb votes), default 25000
# MIN_VOTES=25000
